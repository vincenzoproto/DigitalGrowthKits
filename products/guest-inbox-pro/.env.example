# Guest Inbox Pro deployment template
# Never commit real secrets.

FRONTEND_URL=https://inbox.yourhotel.com
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# Generate strong unique secrets before launch
SECRET_KEY_BASE=replace-with-a-long-random-secret
POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379
REDIS_PASSWORD=replace-with-strong-redis-password

# Account policy
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=en
FORCE_SSL=true

# Outbound email – configure with the client's provider
MAILER_SENDER_EMAIL=Guest Inbox <support@yourhotel.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Storage: local by default. Configure S3-compatible storage for production when required.
ACTIVE_STORAGE_SERVICE=local
