# Store URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe restricted server key with Checkout Sessions read/write access.
# Store the real value only as a sensitive Vercel environment variable.
STRIPE_SECRET_KEY=

# Preferred: authenticated webhook that stores the enquiry in the private
# GuestFlow CRM and sends the owner's notification before acknowledging it.
SETUP_REQUEST_WEBHOOK_URL=

# Optional email delivery fallback (does not itself write to the CRM).
RESEND_API_KEY=
RESEND_FROM=
SETUP_REQUEST_TO=info@vincenzoproto.com
